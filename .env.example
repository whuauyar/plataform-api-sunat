APP_NAME="API SUNAT"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=America/Lima

# Localización: español de Perú
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -------------------------------------------------------
# BASE DE DATOS - activar solo un bloque a la vez
# Por defecto: MySQL (recomendado para este proyecto)
# -------------------------------------------------------

# MySQL (por defecto)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=apisunat
DB_USERNAME=root
DB_PASSWORD=

# PostgreSQL
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=apisunat
# DB_USERNAME=postgres
# DB_PASSWORD=

# SQL Server
# DB_CONNECTION=sqlsrv
# DB_HOST=127.0.0.1
# DB_PORT=1433
# DB_DATABASE=apisunat
# DB_USERNAME=sa
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# -------------------------------------------------------
# BACKUPS (spatie/laravel-backup)
# Respalda la BD + storage/app/private (certs, logos, XML/CDR/PDF locales).
# Requiere mysqldump (MySQL) o pg_dump (Postgres) instalado en el servidor.
# -------------------------------------------------------
BACKUP_NAME=api-sunat
# Disco destino: 'local' (storage/app/private) o 's3' (recomendado en producción).
BACKUP_DISK=local
# Opcional: cifra el .zip del backup (muy recomendado si incluye el .env).
BACKUP_ARCHIVE_PASSWORD=

# -------------------------------------------------------
# ALERTAS DE OPERACIÓN (OpsAlert)
# Backups, jobs fallidos, certificados por vencer, SUNAT caído, disco lleno.
# El VPS bloquea SMTP, así que las alertas van a un webhook (Slack/Discord/n8n)
# y siempre al log. Deja la URL vacía para solo loguear.
# -------------------------------------------------------
OPS_ALERT_WEBHOOK_URL=
OPS_ALERT_LABEL="${APP_NAME}"
OPS_ALERT_THROTTLE_MINUTES=60
OPS_JOBS_FALLIDOS_UMBRAL=1
OPS_CERT_DIAS_AVISO=30
OPS_DISCO_MIN_LIBRE_PCT=10

# -------------------------------------------------------
# COLAS / HORIZON (requiere Redis)
# Horizon gestiona y monitorea las colas (sunat, webhooks, mail, sire, default).
# Solo funciona con QUEUE_CONNECTION=redis. Dashboard en /horizon (solo admins).
# -------------------------------------------------------
# En producción con Redis, cambia a: QUEUE_CONNECTION=redis
# QUEUE_CONNECTION=redis
HORIZON_PATH=horizon
# HORIZON_DOMAIN=

# -------------------------------------------------------
# SENTRY (monitoreo de errores) — opcional, vacío = desactivado
# -------------------------------------------------------
SENTRY_LARAVEL_DSN=
# Muestreo de performance (0 a 1). Déjalo bajo en producción.
SENTRY_TRACES_SAMPLE_RATE=0.1
# No enviar datos personales (IP, cookies, etc.) a Sentry.
SENTRY_SEND_DEFAULT_PII=false

# -------------------------------------------------------
# LICENCIA DE USO (entregada por el proveedor al comprar)
# Requerida para emitir a SUNAT en PRODUCCIÓN. El entorno
# beta (pruebas) funciona sin licencia.
# -------------------------------------------------------
LICENSE_ENABLED=true
LICENSE_SERVER_URL=https://agenda.kodevo.es
LICENSE_KEY=
LICENSE_SECRET=
# Dominio autorizado de esta instalación (por defecto usa APP_URL)
LICENSE_DOMAIN="${APP_URL}"
LICENSE_APP_VERSION=1.0.0
# Días que sigue operando si el servidor de licencias está caído
LICENSE_GRACE_DAYS=7

VITE_APP_NAME="${APP_NAME}"
